---
// The cart as a page: where the header link leads without JavaScript, and a
// place to link to. Everything in it comes from the browser, so it is the same
// static page for everyone.
import config from "astral:config";
import Base from "../layouts/Base.astro";
import Cart from "../components/Cart.astro";
import { env } from "../lib/env.ts";
import { t } from "../lib/i18n.ts";

const locale = config.format.defaultLocale;
const ui = t(locale);
if (!env.shopifyStore) return new Response(null, { status: 404 });
---

<Base locale={locale} title={ui.cart} noindex cartPage>
  <div class="container">
    <Cart locale={locale} page />
  </div>
</Base>
