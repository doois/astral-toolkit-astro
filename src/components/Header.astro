---
// Brand, the "header" menu from the CMS and the language switcher. The mobile
// menu is a <details>: it opens and closes without JavaScript.
import config from "astral:config";
import { getMenu, type Settings } from "../lib/cms.ts";
import { localeName, t } from "../lib/i18n.ts";
import type { MenuItem } from "../lib/astral/index.ts";

type Props = {
  locale: string;
  settings: Settings;
  alternates: { locale: string; url: string | null }[];
  currentPath: string;
  homeOf: (locale: string) => string;
};

const { locale, settings, alternates, currentPath, homeOf } = Astro.props;
const ui = t(locale);
const menu = await getMenu("header", locale);
const siteName = settings.siteName;
const logo = settings.logo;

const norm = (url: string | null | undefined) => (url ? url.replace(/^https?:\/\/[^/]+/, "").replace(/\/+$/, "") || "/" : "");
const isCurrent = (item: MenuItem) => {
  const url = norm(item.url);
  if (!url || url === "#") return false;
  if (url === currentPath) return true;
  // An archive owns the pages under it ("/blog" is current on "/blog/post").
  return item.kind === "archive" && currentPath.startsWith(`${url}/`);
};
const locales = config.format.locales.map((l) => ({ locale: l, href: alternates.find((a) => a.locale === l)?.url ?? homeOf(l), current: l === locale }));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={homeOf(locale)} aria-label={siteName}>
      {logo ? <img class="brand__logo" src={logo.url} alt="" width={logo.width ?? undefined} height={logo.height ?? undefined} /> : <span class="brand__mark" aria-hidden="true" />}
      {!logo && <span>{siteName}</span>}
    </a>
    <nav class="nav" aria-label={ui.menu}>
      <ul class="nav__list">
        {menu.items.map((item) => (
          <li>
            <a class="nav__link" href={item.url ?? "#"} target={item.newTab ? "_blank" : undefined} rel={item.newTab ? "noopener" : undefined} aria-current={isCurrent(item) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      {locales.length > 1 && (
        <ul class="locale-switch" aria-label={ui.language}>
          {locales.map((l) => (
            <li>
              <a href={l.href} hreflang={l.locale} lang={l.locale} aria-current={l.current ? "true" : undefined} title={localeName(l.locale)}>
                {l.locale.split("-")[0]}
              </a>
            </li>
          ))}
        </ul>
      )}
      {menu.items.length > 0 && (
        <details class="nav__toggle">
          <summary aria-label={ui.menu}>{ui.menu}</summary>
          <div class="nav__panel">
            <ul class="nav__list">
              {menu.items.map((item) => (
                <li>
                  <a class="nav__link" href={item.url ?? "#"} aria-current={isCurrent(item) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      )}
    </nav>
  </div>
</header>
