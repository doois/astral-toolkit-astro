# Astral (Doois CMS)
ASTRAL_URL=
ASTRAL_PROJECT=
ASTRAL_TOKEN=
ASTRAL_WEBHOOK_SECRET=
ASTRAL_BUILD_WEBHOOK_ID=

# Opcional: host de midia do CMS (o MEDIA_URL dele, como https://cms-media.doois.com.br). Fecha o img-src da Content-Security-Policy nesse host; vazio, o img-src aceita qualquer https:
ASTRAL_MEDIA_URL=

# O site
SITE_URL=

# Opcional: loja Shopify (app Shopify do CMS). O token e o publico da Storefront API, feito para o navegador; nunca o privado
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Opcional: URL chamada (POST) quando um conteudo estatico muda e o site precisa ser reconstruido
# (webhook de deploy do Dokploy, repository_dispatch do GitHub, etc.)
ASTRAL_REBUILD_HOOK=

# Opcional: formato das URLs por idioma (prefix, prefix-all, domain, none), so para um CMS antigo sem localeUrls no /schema
ASTRAL_LOCALE_URLS=
